// Esquema de Prisma — Portal Inmobiliario
//
// PostgreSQL es la única base de datos de la aplicación (ver `plan.md`).
// Los nombres de tablas y columnas se mapean a snake_case para que la base
// de datos sea cómoda de administrar directamente (pgAdmin, psql).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enumeraciones (spec.md, sección 3)
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum OperationType {
  SALE
  RENT
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  OFFICE
  COMMERCIAL
  OTHER
}

/// La especificación exige soportar USD. Se modela como enumeración para
/// poder incorporar nuevas monedas sin cambiar el tipo de la columna.
enum Currency {
  USD
}

// ---------------------------------------------------------------------------
// Usuarios (spec.md, secciones 15 y 21)
// ---------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  email        String   @unique
  /// Solo se almacena el hash de la contraseña, nunca la contraseña.
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(USER)
  /// Un usuario inactivo no puede autenticarse (plan.md, sección 10).
  isActive     Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Nombre y email sin acentos ni mayúsculas. Columna generada; ver
  /// `Property.searchText`.
  searchText String? @map("search_text")

  favorites Favorite[]
  inquiries Inquiry[]

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Propiedades (spec.md, secciones 3 y 6)
// ---------------------------------------------------------------------------

model Property {
  id String @id @default(cuid())

  title       String
  description String

  operationType OperationType @map("operation_type")
  propertyType  PropertyType  @map("property_type")

  price    Decimal  @db.Decimal(12, 2)
  currency Currency @default(USD)

  /// Superficies y conteos son opcionales porque no todos los tipos de
  /// propiedad los tienen (por ejemplo, un terreno no tiene dormitorios).
  usableAreaSquareMeters Decimal? @map("usable_area_square_meters") @db.Decimal(10, 2)
  totalAreaSquareMeters  Decimal? @map("total_area_square_meters") @db.Decimal(10, 2)
  bedrooms               Int?
  bathrooms              Int?
  parkingSpaces          Int?     @map("parking_spaces")
  ageYears               Int?     @map("age_years")

  /// La ubicación se captura como texto. La latitud y longitud no forman
  /// parte del modelo: la dirección completa se arma para Google Maps
  /// (spec.md, sección 6).
  address String
  commune String
  city    String
  region  String

  isPublished Boolean @default(false) @map("is_published")
  isFeatured  Boolean @default(false) @map("is_featured")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Cuándo salió al portal por primera vez. Lo sella el repositorio al
  /// publicar, no el formulario: es una consecuencia de publicar, no un
  /// campo que alguien rellene. Al despublicar se conserva, porque destruir
  /// una fecha es destruir información y `isPublished` ya responde aparte si
  /// está publicada ahora (spec.md, sección 3).
  publishedAt DateTime? @map("published_at")

  /// Texto de búsqueda sin acentos ni mayúsculas, para que «montana»
  /// encuentre «montaña». Lo mantiene PostgreSQL como columna generada: no
  /// hay que acordarse de escribirlo al crear ni al actualizar, que es justo
  /// lo que se olvida. Nunca se escribe desde la aplicación.
  searchText         String? @map("search_text")
  communeNormalized  String? @map("commune_normalized")
  cityNormalized     String? @map("city_normalized")
  regionNormalized   String? @map("region_normalized")

  /// Cuándo se eliminó. Es un borrado lógico: la propiedad deja de existir
  /// para todo el mundo, pero la fila se conserva para no destruir las
  /// consultas que arrastra, que son contactos comerciales (spec.md,
  /// sección 19).
  deletedAt DateTime? @map("deleted_at")

  images    PropertyImage[]
  features  Feature[]       @relation("PropertyFeatures")
  favorites Favorite[]
  inquiries Inquiry[]

  // Índices orientados a las consultas del catálogo público, que siempre
  // filtran por `isPublished` (spec.md, secciones 8, 10 y 11).
  @@index([deletedAt, isPublished, createdAt])
  @@index([isPublished, createdAt])
  @@index([isPublished, operationType])
  @@index([isPublished, propertyType])
  @@index([isPublished, isFeatured])
  @@index([isPublished, price])
  @@index([isPublished, commune])
  @@index([communeNormalized])
  @@index([cityNormalized])
  @@index([regionNormalized])
  @@map("properties")
}

// ---------------------------------------------------------------------------
// Imágenes (spec.md, secciones 5 y 20)
// ---------------------------------------------------------------------------

model PropertyImage {
  id String @id @default(cuid())

  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  url      String
  /// Identificador del recurso en Cloudinary. Es único para impedir que dos
  /// filas apunten al mismo archivo y se generen referencias huérfanas al
  /// eliminarlo (spec.md, sección 20).
  publicId String @unique @map("public_id")

  position  Int     @default(0)
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")

  // La unicidad de "una sola imagen principal por propiedad" se aplica en la
  // capa de servicios: PostgreSQL la expresaría con un índice único parcial,
  // que Prisma Migrate todavía no modela.
  @@index([propertyId, position])
  @@map("property_images")
}

// ---------------------------------------------------------------------------
// Características (spec.md, sección 4)
// ---------------------------------------------------------------------------

/// Las características se modelan como entidad propia y no como columnas
/// booleanas en `Property`, de modo que agregar una nueva no requiera migrar
/// la tabla de propiedades.
model Feature {
  id String @id @default(cuid())

  name String @unique
  /// Identificador estable para URLs y filtros.
  slug String @unique

  createdAt DateTime @default(now()) @map("created_at")

  properties Property[] @relation("PropertyFeatures")

  @@map("features")
}

// ---------------------------------------------------------------------------
// Favoritos (spec.md, sección 16)
// ---------------------------------------------------------------------------

model Favorite {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  /// Impide duplicados para el mismo usuario y propiedad.
  @@unique([userId, propertyId])
  @@index([userId, createdAt])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
// Solicitudes de información (spec.md, secciones 14 y 22)
// ---------------------------------------------------------------------------

model Inquiry {
  id String @id @default(cuid())

  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Nulo cuando la consulta proviene de un visitante no autenticado
  /// (plan.md, sección 5). Si el usuario se elimina, la consulta se conserva.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name    String
  email   String
  phone   String?
  message String

  createdAt DateTime @default(now()) @map("created_at")

  /// Cuándo la ocultó de su historial quien la envió. La solicitud se
  /// conserva para ADMIN: es el contacto que la inmobiliaria debe responder
  /// y quien escribió no puede hacerlo desaparecer (spec.md, sección 17).
  hiddenByUserAt DateTime? @map("hidden_by_user_at")

  /// Nombre, email y mensaje sin acentos ni mayúsculas. Columna generada;
  /// ver `Property.searchText`.
  searchText String? @map("search_text")

  @@index([propertyId, createdAt])
  @@index([userId, hiddenByUserAt, createdAt])
  @@index([createdAt])
  @@map("inquiries")
}
