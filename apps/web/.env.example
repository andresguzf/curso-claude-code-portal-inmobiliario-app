# ---------------------------------------------------------------------------
# Frontend (@portal/web) — variables de entorno
#
# Copiar como `.env` y completar con valores reales.
# Solo las variables con prefijo NEXT_PUBLIC_ llegan al navegador.
# ---------------------------------------------------------------------------

# URL pública del sitio, utilizada para metadata y Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# URL interna del backend, usada por el servidor y por el proxy de
# `next.config.ts`. El navegador nunca la ve.
API_INTERNAL_URL="http://localhost:3001"

# Clave del Maps JavaScript API. Es pública por diseño: el mapa se dibuja
# en el navegador y la clave viaja en el HTML. Se protege restringiéndola
# por referrer y por API en Google Cloud, no ocultándola.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Clave de acceso de Web3Forms para el formulario de contacto. Es pública
# por diseño: Web3Forms rechaza los envíos desde el servidor en su plan
# gratuito, así que el correo sale del navegador. No da acceso a ninguna
# cuenta; se protege restringiendo el dominio en el panel de Web3Forms.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=""
